generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") directUrl = env("DIRECT_URL") }

enum Role { Student Teacher Admin ContentEditor }
enum LessonType { reading listening vocab grammar speaking writing }
enum CEFLevel { A1 A2 B1 B2 C1 C2 }
enum QuestionType { MCQ gap_fill matching reorder dictation short_answer }
model User { id String @id @default(cuid()) email String @unique passwordHash String name String role Role @default(Student) createdAt DateTime @default(now()) sessions Session[] attempts Attempt[] vocabItems VocabItem[] srsCards SrsCard[] notifications Notification[] classroomMemberships ClassroomMember[] taughtClassrooms Classroom[] @relation("TeacherClassrooms") auditLogs AuditLog[] }
model Session { id String @id @default(cuid()) userId String tokenHash String @unique expiresAt DateTime createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,expiresAt]) }
model Course { id String @id @default(cuid()) title String description String? units Unit[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Unit { id String @id @default(cuid()) courseId String title String order Int course Course @relation(fields:[courseId],references:[id],onDelete:Cascade) lessons Lesson[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([courseId]) }
model Lesson { id String @id @default(cuid()) unitId String title String type LessonType level CEFLevel durationMin Int tags String[] content String unit Unit @relation(fields:[unitId],references:[id],onDelete:Cascade) questions Question[] attempts Attempt[] assignments Assignment[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([unitId]) }
model Question { id String @id @default(cuid()) lessonId String? prompt String type QuestionType options Json? correctAnswer String explanation String? difficulty Int @default(1) tags String[] lesson Lesson? @relation(fields:[lessonId],references:[id],onDelete:SetNull) attemptAnswers AttemptAnswer[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([lessonId]) }
model Attempt { id String @id @default(cuid()) userId String lessonId String score Int timeSpentSec Int createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) lesson Lesson @relation(fields:[lessonId],references:[id],onDelete:Cascade) answers AttemptAnswer[] @@index([userId,createdAt]) }
model AttemptAnswer { id String @id @default(cuid()) attemptId String questionId String userAnswer String isCorrect Boolean attempt Attempt @relation(fields:[attemptId],references:[id],onDelete:Cascade) question Question @relation(fields:[questionId],references:[id],onDelete:Cascade) }
model VocabItem { id String @id @default(cuid()) userId String word String meaning String example String? sourceLessonId String? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) srsCards SrsCard[] @@index([userId,word]) }
model SrsCard { id String @id @default(cuid()) userId String vocabItemId String easeFactor Float @default(2.5) interval Int @default(1) repetitions Int @default(0) dueAt DateTime lastReviewedAt DateTime? user User @relation(fields:[userId],references:[id],onDelete:Cascade) vocabItem VocabItem @relation(fields:[vocabItemId],references:[id],onDelete:Cascade) @@index([userId,dueAt]) }
model PlacementTest { id String @id @default(cuid()) userId String score Int cefr String createdAt DateTime @default(now()) answers PlacementAnswer[] @@index([userId,createdAt]) }
model PlacementAnswer { id String @id @default(cuid()) placementTestId String questionId String answer String isCorrect Boolean placementTest PlacementTest @relation(fields:[placementTestId],references:[id],onDelete:Cascade) }
model LearningPlan { id String @id @default(cuid()) userId String startDate DateTime createdAt DateTime @default(now()) items PlanItem[] @@index([userId]) }
model PlanItem { id String @id @default(cuid()) planId String lessonId String scheduledAt DateTime completedAt DateTime? plan LearningPlan @relation(fields:[planId],references:[id],onDelete:Cascade) }
model Classroom { id String @id @default(cuid()) teacherId String name String inviteCode String @unique createdAt DateTime @default(now()) teacher User @relation("TeacherClassrooms",fields:[teacherId],references:[id],onDelete:Cascade) members ClassroomMember[] assignments Assignment[] }
model ClassroomMember { id String @id @default(cuid()) classroomId String userId String role String @default("Student") classroom Classroom @relation(fields:[classroomId],references:[id],onDelete:Cascade) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@unique([classroomId,userId]) }
model Assignment { id String @id @default(cuid()) classroomId String lessonId String dueAt DateTime? createdAt DateTime @default(now()) classroom Classroom @relation(fields:[classroomId],references:[id],onDelete:Cascade) lesson Lesson @relation(fields:[lessonId],references:[id],onDelete:Cascade) }
model Notification { id String @id @default(cuid()) userId String type String message String readAt DateTime? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,readAt]) }
model AuditLog { id String @id @default(cuid()) actorId String action String target String metadata Json? createdAt DateTime @default(now()) actor User @relation(fields:[actorId],references:[id],onDelete:Cascade) }
model ChangeLog { id String @id @default(cuid()) actorId String entity String entityId String summary String before Json? after Json? createdAt DateTime @default(now()) }
